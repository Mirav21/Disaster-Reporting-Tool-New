generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Report {
    id                String              @id @default(cuid())
    reportId          String              @unique
    type              ReportType
    reportType        String
    title             String
    description       String
    location          String?
    latitude          Float?
    longitude         Float?
    image             String?
    status            ReportStatus        @default(PENDING)
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    userId            Int
    user              User                @relation(fields: [userId], references: [id])
    assignedTeams    RescueTeam[]       @relation("ReportRescueTeam")
    moderatorResponses ModeratorResponse[]

    @@index([reportId])
    SOSAlert SOSAlert[]
}

model User {
  id          Int                 @id @default(autoincrement())
  email       String              @unique
  name        String
  password    String
  role        Role                @default(USER)
  location    String
  latitude    Float
  longitude   Float
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  reports     Report[]
  responses   ModeratorResponse[]
}

model RescueTeam {
    id             String   @id @default(cuid())
    name           String
    specialization String
    isAvailable    Boolean  @default(true)
    reports        Report[] @relation("ReportRescueTeam")
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@map("rescue_teams")
}

model ModeratorResponse {
    id           String   @id @default(cuid())
    message      String
    createdAt    DateTime @default(now())
    reportId     String
    report       Report    @relation(fields: [reportId], references: [id])
    moderatorId  Int
    moderator    User      @relation(fields: [moderatorId], references: [id])

    @@map("moderator_responses")
}

model SOSAlert {
  id            String   @id @default(cuid())
  report        Report   @relation(fields: [reportId], references: [id])
  reportId      String
  radius        Float
  message       String
  recipientCount Int
  createdAt     DateTime @default(now())
}

enum Role {
    ADMIN
    MODERATOR
    USER
}

enum ReportStatus {
    PENDING
    IN_PROGRESS
    RESOLVED
    DISMISSED
}

enum ReportType {
    CRITICAL
    LOW_PRIORITY
    EMERGENCY
    NON_EMERGENCY
}
